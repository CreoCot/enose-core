#!/bin/sh
set -e

BACKUP_DIR="{{ backup_dir }}"
RETENTION_DAYS={{ backup_retention_days }}
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
BACKUP_FILE="${BACKUP_DIR}/enose_db_${TIMESTAMP}.sql.gz"

mkdir -p "$BACKUP_DIR"

docker exec {{ backup_postgres_container }} sh -c 'pg_dump -U "${POSTGRES_USER:-postgres}" "${POSTGRES_DB:-enose}"' | gzip > "$BACKUP_FILE"

find "$BACKUP_DIR" -type f -name "enose_db_*.sql.gz" -mtime +$RETENTION_DAYS -delete
