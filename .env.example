# Single source of truth for all secrets/config used by `docker compose up`.
# Copy to .env and fill in real values — .env is gitignored.
#
# Read automatically by Docker Compose for ${VAR} substitution AND injected
# into containers via `env_file:`. apps/backend/.env (if present) overrides
# these for non-Docker local development only.

# PostgreSQL
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=enose
DATABASE_PORT=5432

# pgAdmin
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Backend
BACKEND_PORT=8080
ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_SECRET=change-me-in-production

# Frontend
FRONTEND_PORT=5173

# Parser
PARSER_PORT=8001
PARSER_URL=http://parser:8001
PARSER_API_KEY=example_api_key

# Report
REPORT_PORT=8002
REPORT_URL=http://report:8002
REPORT_API_KEY=example_api_key

# ML
ML_PORT=8003
ML_URL=http://ml:8003
ML_API_KEY=example_api_key
